# Only Docker Desktop is required on the host.
# Start-Docker.ps1 creates .env automatically when it does not exist.

APP_PORT=8080

POSTGRES_PASSWORD=cbai_local_password
MINIO_ROOT_USER=cbai_minio
MINIO_ROOT_PASSWORD=cbai_minio_password
S3_BUCKET=cbai-private

# Exactly 32 random bytes encoded as base64.
AI_CONFIG_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Optional fallback. Recommended: enter the key in the application UI after login.
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.6-flash

# Keep true for the local MVP. Set false after creating real accounts.
SEED_DEMO_DATA=true
