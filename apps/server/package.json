{
    "name":  "@cbai/server",
    "version":  "2.0.2",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/index.ts",
                    "build":  "tsup src/index.ts --format esm --sourcemap --clean",
                    "start":  "node dist/index.js",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run --exclude src/**/*.integration.test.ts",
                    "test:integration":  "vitest run src/**/*.integration.test.ts"
                },
    "dependencies":  {
                         "@aws-sdk/client-s3":  "3.821.0",
                         "@aws-sdk/s3-request-presigner":  "3.821.0",
                         "@google/genai":  "2.13.0",
                         "@prisma/client":  "6.19.2",
                         "argon2":  "0.41.1",
                         "cookie-parser":  "1.4.7",
                         "cors":  "2.8.5",
                         "dotenv":  "17.2.3",
                         "express":  "5.2.1",
                         "file-type":  "20.5.0",
                         "helmet":  "8.1.0",
                         "ipaddr.js":  "2.2.0",
                         "multer":  "2.2.0",
                         "pino":  "9.7.0",
                         "pino-http":  "10.4.0",
                         "sharp":  "0.34.2",
                         "zod":  "3.25.32"
                     },
    "devDependencies":  {
                            "@types/cookie-parser":  "1.4.8",
                            "@types/cors":  "2.8.18",
                            "@types/express":  "5.0.6",
                            "@types/multer":  "1.4.12",
                            "@types/supertest":  "6.0.3",
                            "supertest":  "7.1.1",
                            "tsup":  "8.5.0",
                            "vitest":  "3.1.4"
                        }
}
